# Copy to .env for local development. Never commit real values.
# Database variables come from the Supabase integration: `vercel env pull .env.preview.local --environment=preview`
# (ozy-local loads .env and then .env.preview.local, so local work uses the preview database by default).

# 32 random bytes as hex (64 chars). Encrypts webhook secrets. Different per environment.
OZY_ENCRYPTION_KEY=
# 32+ random characters. Bearer token for /api/v1/internal/tick (pg_cron and Vercel cron).
CRON_SECRET=
# Public origin used for CSRF checks, cookies and generated URLs.
PUBLIC_ORIGIN=http://127.0.0.1:3917
PORT=3917

# Optional self-hosted worker (OCR, screenshots, JS rendering, browser metrics).
OZY_WORKER_URL=
OZY_WORKER_SECRET=

# Optional quota overrides (defaults: 20 / 100 / 2000 units).
# OZY_UNITS_PER_MINUTE=20
# OZY_UNITS_PER_DAY=100
# OZY_PLATFORM_UNITS_PER_DAY=2000
